#!/usr/bin/env python3
"""hygiene: the public-hygiene scan (conventions section 6, overhaul-r1 section 5).

Scans the working tree of a repo (`git ls-files -co --exclude-standard`: the
tracked and untracked-not-ignored regular files and symlinks) for the generic
pattern groups below and the private list's, and prints counts only, never a
matched line or a private pattern: an uncommitted file is
scanned before its commit, an ignored one never. Each file's path is a scanned
line of that file, for every group; a symlink is its path and its target
(`readlink`), never the target's content. A file over 4 MiB is streamed in 1 MiB
chunks, cut at a line boundary (a longer line carried at most 64 KiB, then kept
by a 4 KiB overlap), with the first chunk's codec, and counted as `oversize`
(ADV11-3): every byte is scanned, memory stays bounded. A file starting with a UTF-16
BOM, or whose first 8 KB have NULs on 90% or more of the odd or the even bytes
(not both), is decoded as UTF-16 and scanned as text. Else a file whose first
8 KB hold a NUL is binary: it is scanned for the `home`, `secret` and `email`
groups only (ADV10-17), over its printable runs of 8 or more bytes (as `strings`
would), one line per run.

The private list holds the patterns that name the owner, a private repo, a host,
a device or a domain; they never sit in this file or in the repo. It is read from
$AGENTIK_HYGIENE_PRIVATE, else ${XDG_CONFIG_HOME:-$HOME/.config}/agentik/
hygiene-private.tsv: UTF-8, one `group<TAB>regex` per line, `#` comments and blank
lines skipped. A row joins its group, or makes a new one; each private pattern
ignores case. An absent list prints one stderr line and the scan runs on the
generic groups; `--require-private` makes an absent or unreadable list exit 2. A
bad row is a usage error that names its line, never its pattern.

`.hygiene-allow` lists
exceptions, one per line: `<path-glob>: <group>[,<group>]`, `#` comments; a
glob's `*` stays inside one path segment; a group name this scan does not load
allows nothing; a `secret` exception outside
`tests/fixtures/` is a usage error. Under `history/sittings/` (charters are
records) the `person` and `sibling` groups are not evaluated; the rest still
scan there. `secret` is matched case-sensitively, the others ignore case.

Usage: hygiene [--json] [--allow FILE] [--repo DIR] [--require-private]
Exit 0 when no hit lies outside the allowlist, 2 when one does or when
--require-private finds no readable private list, 1 on usage or when git fails. Stdlib only; one file, copied byte-identical into each repo.

The patterns below are written so that this file does not match itself.
"""
import codecs
import fnmatch
import itertools
import json
import os
import re
import subprocess
import sys

GROUPS = (
    ("home", (r"/Users/[a-z]+", r"~/cod[e]/")),
    ("lan", (r"192\.168\.", r"\b10\.\d+\.\d+\.\d+",
             r"\b172\.(?:1[6-9]|2\d|3[01])\.\d+\.\d+",
             r"\b[a-z0-9-]+\.loca[l](?![\w.-])")),
    ("secret", (r"sk-an[t]-[A-Za-z0-9_-]+", r"gh[p]_[A-Za-z0-9]{20,}",
                r"github_pa[t]_[A-Za-z0-9_]{20,}", r"AGE-SECRET-KE[Y]-1[0-9A-Z]{20,}",
                r"\bAKI[A][0-9A-Z]{16}\b", r"BEGI[N] [A-Z0-9 ]*PRIVATE KEY")),
    ("email", (r"\b[A-Za-z0-9._%+-]+[@][A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}\b",)),
)
CASE_SENSITIVE = ("secret",)
PRIVATE_ENV = "AGENTIK_HYGIENE_PRIVATE"
GROUP_NAME = re.compile(r"[a-z][a-z0-9_-]*\Z")
BINARY_PROBE = 8192
UTF16_NUL = 0.9
READ_CAP = 4 * 1024 * 1024
CHUNK = 1024 * 1024
LINE_CARRY = 64 * 1024
OVERLAP = 4 * 1024
LAST_BREAK = re.compile(rb"[^\x20-\x7e\t][\x20-\x7e\t]*\Z")
RECORDS = ("history/sittings/",)
RECORDS_SKIP = ("person", "sibling")  # private-list groups, when loaded
BINARY_GROUPS = ("home", "secret", "email")
PRINTABLE_RUN = re.compile(rb"[\x20-\x7e\t]{8,}")
SECRET_ALLOW_ROOT = ["tests", "fixtures"]


class UsageError(Exception):
    pass


def compile_groups(private):
    """[(group, [regex])]: each generic group as one regex (only `secret` keeps
    case), then the private rows joined to their group, or new groups in first-seen
    order, as one case-blind regex per group."""
    names = [name for name, _ in GROUPS]
    out = {name: [re.compile("|".join(pats), 0 if name in CASE_SENSITIVE else re.IGNORECASE)]
           for name, pats in GROUPS}
    extra = {}
    for group, pattern in private:
        if group not in out and group not in extra:
            names.append(group)
        extra.setdefault(group, []).append(pattern)
    for group, pats in extra.items():
        out.setdefault(group, []).append(re.compile("|".join(pats), re.IGNORECASE))
    return [(name, out[name]) for name in names]


COMPILED = compile_groups(())
GROUP_NAMES = [name for name, _ in COMPILED]


def use_groups(private):
    global COMPILED, GROUP_NAMES
    COMPILED = compile_groups(private)
    GROUP_NAMES = [name for name, _ in COMPILED]


def private_path(env):
    """$AGENTIK_HYGIENE_PRIVATE, else ${XDG_CONFIG_HOME:-$HOME/.config}/agentik/..."""
    if env.get(PRIVATE_ENV):
        return env[PRIVATE_ENV]
    base = env.get("XDG_CONFIG_HOME") or os.path.join(env.get("HOME") or os.path.expanduser("~"),
                                                       ".config")
    return os.path.join(base, "agentik", "hygiene-private.tsv")


def load_private(path):
    """[(group, pattern)] from the private list. Raises OSError or ValueError when
    the file cannot be read as UTF-8, UsageError naming path:line (never the
    pattern) on a bad row."""
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    rows = []
    for n, raw in enumerate(text.splitlines(), 1):
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        group, sep, pattern = raw.partition("\t")
        group, pattern = group.strip(), pattern.strip()
        if not sep or not GROUP_NAME.match(group) or not pattern:
            raise UsageError("%s:%d: bad private row, want group<TAB>regex" % (path, n))
        try:
            re.compile(pattern, re.IGNORECASE)
        except re.error:
            raise UsageError("%s:%d: bad private regex" % (path, n)) from None
        rows.append((group, pattern))
    return rows


def parse_args(argv):
    opts = {"json": False, "allow": None, "repo": ".", "require_private": False}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--json":
            opts["json"] = True
        elif arg == "--require-private":
            opts["require_private"] = True
        elif arg in ("--allow", "--repo"):
            if i + 1 >= len(argv):
                raise UsageError("%s needs a value" % arg)
            opts[arg[2:]] = argv[i + 1]
            i += 1
        elif arg in ("-h", "--help"):
            raise UsageError(None)
        else:
            raise UsageError("unknown argument: %s" % arg)
        i += 1
    return opts


def load_allow(path, required):
    """Return [(glob, {groups})]; a missing default file is an empty list."""
    if not os.path.exists(path):
        if required:
            raise UsageError("allow file not found: %s" % path)
        return []
    entries = []
    with open(path, encoding="utf-8") as fh:
        for n, raw in enumerate(fh, 1):
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            glob, sep, groups = line.rpartition(":")
            names = {g.strip() for g in groups.split(",") if g.strip()}
            glob = glob.strip()
            if not sep or not glob or not names or not all(map(GROUP_NAME.match, names)):
                raise UsageError("%s:%d: bad entry" % (path, n))
            parts = glob.split("/")
            if "secret" in names and (parts[:2] != SECRET_ALLOW_ROOT or len(parts) < 3):
                raise UsageError("%s:%d: a secret exception lies only under tests/fixtures/"
                                 % (path, n))
            entries.append((glob, names))
    return entries


def glob_match(path, glob):
    parts, pats = path.split("/"), glob.split("/")
    return len(parts) == len(pats) and all(
        fnmatch.fnmatchcase(p, g) for p, g in zip(parts, pats))


def allowed(path, group, entries):
    return any(group in groups and glob_match(path, glob) for glob, groups in entries)


def files(repo):
    try:
        out = subprocess.run(
            ["git", "-C", repo, "ls-files", "-z", "--cached", "--others",
             "--exclude-standard"], capture_output=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError) as exc:
        raise UsageError("git ls-files failed in %s: %s" % (repo, exc))
    paths = {p for p in out.decode("utf-8", "surrogateescape").split("\0") if p}
    return sorted(p for p in paths if os.path.islink(os.path.join(repo, p))
                  or os.path.isfile(os.path.join(repo, p)))


def utf16(data):
    """The codec a UTF-16 file decodes with, or None: a BOM, or NULs on at
    least 90% of the odd or the even bytes of the probe (not both: all NUL is
    binary)."""
    if data[:2] in (b"\xff\xfe", b"\xfe\xff"):
        return "utf-16"
    probe = data[:BINARY_PROBE]
    even, odd = probe[0::2], probe[1::2]
    if len(odd) < 2:
        return None
    even_nul = even.count(0) >= UTF16_NUL * len(even)
    odd_nul = odd.count(0) >= UTF16_NUL * len(odd)
    if odd_nul != even_nul:
        return "utf-16-le" if odd_nul else "utf-16-be"
    return None


def pieces(buf, binary):
    """The scanned lines of a whole buffer: a text's lines, or a binary's printable runs."""
    if binary:
        return [(m.group().decode("ascii"), BINARY_GROUPS) for m in PRINTABLE_RUN.finditer(buf)]
    return [(line, GROUP_NAMES) for line in buf.splitlines()]


def stream(full):
    """An oversize file's lines, CHUNK at a time: each buffer is cut after its last line
    break (a text's newline, a binary's non-printable byte), so no line or run is split;
    a carry past LINE_CARRY is scanned and only its last OVERLAP kept."""
    with open(full, "rb") as fh:
        chunk = fh.read(CHUNK)
        codec = utf16(chunk)
        binary = not codec and b"\0" in chunk[:BINARY_PROBE]
        decoder = None if binary else codecs.getincrementaldecoder(codec or "utf-8")("replace")
        carry = b"" if binary else ""
        while chunk:
            buf = carry + (chunk if binary else decoder.decode(chunk))
            if binary:
                m = LAST_BREAK.search(buf)
                cut = m.start() + 1 if m else 0
            else:
                cut = buf.rfind("\n") + 1
            yield from pieces(buf[:cut], binary)
            carry = buf[cut:]
            if len(carry) > LINE_CARRY:
                yield from pieces(carry, binary)
                carry = carry[-OVERLAP:]
            chunk = fh.read(CHUNK)
        if not binary:
            carry += decoder.decode(b"", final=True)
        yield from pieces(carry, binary)


def read_lines(path, full):
    """([(line, groups)], oversize) for one entry: its path, then a symlink's
    target, a text file's lines (UTF-16 decoded), or a binary's printable runs
    (for BINARY_GROUPS only); a file over READ_CAP is streamed."""
    rows = [(path, GROUP_NAMES)]
    if os.path.islink(full):
        target = os.readlink(full)
        return rows + [(target, GROUP_NAMES)], False
    with open(full, "rb") as fh:
        data = fh.read(READ_CAP + 1)
    if len(data) > READ_CAP:
        return itertools.chain(rows, stream(full)), True
    codec = utf16(data)
    if codec:
        return rows + pieces(data.decode(codec, "replace"), False), False
    if b"\0" in data[:BINARY_PROBE]:
        return rows + pieces(data, True), False
    return rows + pieces(data.decode("utf-8", "replace"), False), False


def scan(repo, entries):
    groups = {name: {"lines": 0, "files": 0} for name in GROUP_NAMES}
    outside, oversize = [], 0
    for path in files(repo):
        counts = dict.fromkeys(GROUP_NAMES, 0)
        lines, big = read_lines(path, os.path.join(repo, path))
        oversize += big
        for line, names in lines:
            for name, rxs in COMPILED:
                if name not in names:
                    continue
                if name in RECORDS_SKIP and path.startswith(RECORDS):
                    continue
                if any(rx.search(line) for rx in rxs):
                    counts[name] += 1
        for name in GROUP_NAMES:
            if not counts[name]:
                continue
            groups[name]["lines"] += counts[name]
            groups[name]["files"] += 1
            if not allowed(path, name, entries):
                outside.append({"path": path, "group": name, "lines": counts[name]})
    return {"groups": groups,
            "hits_outside_allowlist": sum(f["lines"] for f in outside),
            "files": outside, "oversize": oversize}


def render(result):
    rows = ["%-8s %6s %6s" % ("group", "lines", "files")]
    for name in GROUP_NAMES:
        g = result["groups"][name]
        rows.append("%-8s %6d %6d" % (name, g["lines"], g["files"]))
    if result["files"]:
        rows.append("")
        rows.append("outside the allowlist:")
        for f in result["files"]:
            rows.append("%s  %s  %d" % (f["path"], f["group"], f["lines"]))
    if result["oversize"]:
        rows.append("oversize (streamed): %d" % result["oversize"])
    rows.append("hits outside allowlist: %d" % result["hits_outside_allowlist"])
    return "\n".join(rows)


def main(argv):
    try:
        opts = parse_args(argv[1:])
        listed = private_path(os.environ)
        try:
            use_groups(load_private(listed))
        except (OSError, ValueError) as exc:
            gone = isinstance(exc, FileNotFoundError)
            what = "no private list at %s" % listed if gone else (
                "private list unreadable at %s" % listed)
            if opts["require_private"]:
                sys.stderr.write("hygiene: %s; --require-private\n" % what)
                return 2
            sys.stderr.write("hygiene: %s; generic groups only\n" % what)
        repo = opts["repo"]
        allow = opts["allow"] or ".hygiene-allow"
        if not os.path.isabs(allow):
            allow = os.path.join(repo, allow)
        result = scan(repo, load_allow(allow, opts["allow"] is not None))
    except UsageError as exc:
        if exc.args and exc.args[0]:
            sys.stderr.write("hygiene: %s\n" % exc.args[0])
        sys.stderr.write("usage: hygiene [--json] [--allow FILE] [--repo DIR]"
                         " [--require-private]\n")
        return 1
    if opts["json"]:
        print(json.dumps(result, indent=1, sort_keys=True))
    else:
        print(render(result))
    return 0 if result["hits_outside_allowlist"] == 0 else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
